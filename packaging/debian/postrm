#!/bin/sh
set -e

root=${DPKG_ROOT:-}
case "$1" in
    remove|purge)
        if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d "$root/usr/share/icons/hicolor" ]; then
            gtk-update-icon-cache -q -f -t "$root/usr/share/icons/hicolor" || true
        fi
        if command -v update-desktop-database >/dev/null 2>&1 && [ -d "$root/usr/share/applications" ]; then
            update-desktop-database "$root/usr/share/applications" || true
        fi
        ;;
esac
exit 0
